# Paths assume the repository is cloned at `/home/pi/renfrew-yoker-bridge-checker` and
# its virtual environment created at `.venv`, under the user `pi` - the username the
# README's "Setting up the Raspberry Pi" has you pick in Raspberry Pi Imager. Edit
# `User` and both paths if yours differ. `PYTHONPATH` is relative, so it resolves
# against `WorkingDirectory`.
#
# Output is left to journald, which is what makes the logging of the scrape readable
# through `journalctl -u bridge-checker.service`.

[Unit]
Description=Renfrew-Yoker bridge closure scrape
Documentation=https://github.com/gregor-mcintyre/renfrew-yoker-bridge-checker
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/renfrew-yoker-bridge-checker
Environment=PYTHONPATH=shared:raspberry_pi
ExecStart=/home/pi/renfrew-yoker-bridge-checker/.venv/bin/python -m bridge_closures
